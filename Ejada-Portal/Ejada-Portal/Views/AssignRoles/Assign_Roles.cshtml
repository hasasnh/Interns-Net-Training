
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    body {
        background: #eceff1;
        font-family: "Segoe UI", sans-serif;
    }

    .card-custom {
        border-radius: 16px;
        border: none;
        box-shadow: 0 6px 18px rgba(0,0,0,0.1);
        overflow: hidden;
        background: #fff;
    }

    .card-header {
        background: #111;
        color: #fff;
        font-weight: 600;
        font-size: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
    }

    #clientsTable {
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }

        #clientsTable thead {
            background: #000;
            color: #fff;
        }

            #clientsTable thead th {
                text-align: center;
                vertical-align: middle;
                font-size: 15px;
            }

        #clientsTable tbody tr {
            transition: all 0.25s ease;
        }

            #clientsTable tbody tr:hover {
                background: #f8f9fa;
                transform: scale(1.01);
                box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            }

    /* search box */
    #searchName {
        max-width: 280px;
        border-radius: 10px;
        border: 1px solid #bbb;
    }

    /* pages grid new design (Tag style) */
    td .pages-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .pages-grid .page-box {
        background: #f5f5f5;
        border: 1px solid #ccc;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pages-grid .page-box:hover {
            background: #000;
            color: #fff;
            border-color: #000;
            box-shadow: 0 3px 8px rgba(0,0,0,0.2);
        }

    .pages-grid input {
        accent-color: black;
    }

    /* save button floating */
    #saveRolesBtn {
        position: fixed;
        bottom: 28px;
        right: 40px;
        border-radius: 50px;
        padding: 14px 30px;
        font-weight: 600;
        font-size: 15px;
        background: #000;
        color: #fff;
        border: none;
        box-shadow: 0 6px 18px rgba(0,0,0,0.4);
        transition: all 0.25s ease;
    }

        #saveRolesBtn:hover {
            background: #fff;
            color: #000;
            border: 1px solid #000;
            transform: scale(1.05);
        }
</style>

<div class="container mt-4">
    <div class="card card-custom">
        <div class="card-header">
            <i class="bi bi-people-fill"></i> Assign Roles to Users
        </div>
        <div class="card-body">
            <div class="mb-3 d-flex justify-content-between flex-wrap">
                <input type="text" id="searchName" class="form-control" placeholder=" Search by Name">
            </div>

            <table id="clientsTable" class="table table-bordered align-middle text-center">
                <thead>
                    <tr>
                        <th><i class="bi bi-person"></i> Name</th>
                        <th><i class="bi bi-envelope"></i> Email</th>
                        <th style="width:160px;"><i class="bi bi-shield-lock"></i> Role</th>
                        <th><i class="bi bi-window-stack"></i> Pages</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <button id="saveRolesBtn"><i class="bi bi-save2"></i> Save Changes</button>
</div>



<script>
    $(document).ready(function () {
        var rolesList = [];
        var pagesList = [];

        // Get Roles
        $.ajax({
            url: '/AssignRoles/GetAllRoles',
            method: 'GET',
            async: false,
            success: function(data) {
                rolesList = data;
            }
        });

        // Get Pages
        $.ajax({
            url: '/AssignRoles/GetAllPages',
            method: 'GET',
            async: false,
            success: function(data) {
                pagesList = data;
            }
        });

        var table = $('#clientsTable').DataTable({
            ajax: {
                url: '/AssignRoles/GetUsers',
                dataSrc: 'data'
            },
            responsive: true,
            pageLength: 5,
            language: {
                emptyTable: "No users found",
                lengthMenu: "Show _MENU_ entries",
                paginate: { previous: "⬅", next: "➡" }
            },
            columns: [
                { data: 'name' },
                { data: 'email' },
                {
                    data: 'role',
                    render: function(data) {
                        var select = '<select class="form-select form-select-sm role-select">';
                        select += '<option value="">Select Role</option>';
                        rolesList.forEach(function(role) {
                            select += '<option value="' + role + '"' + (data === role ? ' selected' : '') + '>' + role + '</option>';
                        });
                        select += '</select>';
                        return select;
                    }
                },
                {
                    data: 'permissions',
                    render: function(data) {
                        var boxes = '<div class="pages-grid">';
                        pagesList.forEach(function(page) {
                            var checked = (data && data.includes(page)) ? 'checked' : '';
                            boxes += `
                                <label class="page-box">
                                    <input class="form-check-input page-checkbox" type="checkbox" value="${page}" ${checked}>
                                    ${page}
                                </label>`;
                        });
                        boxes += '</div>';
                        return boxes;
                    }
                }
            ]
        });

        // custom search
        $('#searchName').on('keyup', function () {
            table.column(0).search(this.value).draw();
        });

        // Save roles
        $('#saveRolesBtn').click(function () {
            var rolesData = [];

            table.rows({ search: 'applied' }).every(function () {
                var data = this.data();
                var $row = $(this.node());
                var role = $row.find('.role-select').val();
                var pages = [];
                $row.find('.page-checkbox:checked').each(function () {
                    pages.push($(this).val());
                });

                rolesData.push({
                    id: data.id,
                    role: role,
                    permissions: pages
                });
            });

            $.ajax({
                url: '/AssignRoles/SaveRoles',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(rolesData),
                success: function() {
                    alert(' Roles and pages updated successfully!');
                    table.ajax.reload();
                },
                error: function() {
                    alert(' Error updating roles and pages.');
                }
            });
        });
    });
</script>
