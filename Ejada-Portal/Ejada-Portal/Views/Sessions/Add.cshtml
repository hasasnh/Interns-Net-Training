@model Application.DTOs.SessionDto
@{
    ViewData["Title"] = "Add Session";
}
<style>
    :root {
        --bg: #0b1020;
        --card: #121933;
        --muted: #7c8db5;
        --text: #e9edff;
        --border: rgba(255,255,255,.08);
        --accent1: #6aa7ff;
        --accent2: #60e6c5;
    }

    .add-wrap {
        max-width: 820px;
        margin: 32px auto;
        padding: 0 18px
    }

    .card {
        background: linear-gradient(180deg,rgba(255,255,255,.02),transparent),var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 12px 30px rgba(0,0,0,.35);
    }

    .card-hd {
        padding: 18px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 10px;
        align-items: center
    }

    .badge {
        font-weight: 700;
        font-size: .8rem;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px dashed rgba(255,255,255,.18);
        background: linear-gradient(135deg,rgba(106,167,255,.22),rgba(96,230,197,.22));
    }

    .h1 {
        font-size: 1.15rem;
        margin: 0;
        color: var(--text)
    }

    .card-bd {
        padding: 22px
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px
    }

    .lbl {
        color: #c9d7ff;
        font-size: .92rem;
        margin-bottom: 6px;
        display: block
    }

    .inp {
        width: 100%;
        padding: 14px 12px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.04);
        color: var(--text);
        outline: none;
        transition: .18s
    }

        .inp:focus {
            border-color: rgba(106,167,255,.6);
            box-shadow: 0 0 0 4px rgba(106,167,255,.18)
        }

    .hint {
        color: var(--muted);
        font-size: .82rem;
        margin-top: 6px
    }

    .actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 14px
    }

    .btn {
        appearance: none;
        border: 1px solid var(--border);
        background: linear-gradient(180deg,rgba(255,255,255,.06),transparent);
        color: var(--text);
        padding: 12px 16px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 700
    }

    .btn-primary {
        border-color: rgba(106,167,255,.35);
        background: linear-gradient(135deg,rgba(106,167,255,.28),rgba(96,230,197,.28))
    }

    .err {
        color: #ff6b6b;
        font-size: .85rem
    }
</style>

<div class="add-wrap">
    <div class="card">
        <div class="card-hd">
            <span class="badge">Create</span>
            <h2 class="h1">Add Session</h2>
        </div>
        <div class="card-bd">
            <partial name="~/Views/Shared/_Notification.cshtml" />
            <form asp-action="Add" asp-controller="Sessions" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div>
                        <label class="lbl" asp-for="PresenterName">Presenter Name</label>
                        <input class="inp" asp-for="PresenterName" placeholder="e.g. : Mohammad Mustafa" />
                        <span class="err" asp-validation-for="PresenterName"></span>
                    </div>
                    <div>
                        <label class="lbl" asp-for="SessionName">Session Name</label>
                        <input class="inp" asp-for="SessionName" placeholder="e.g. : MVC Introduction" />
                        <span class="err" asp-validation-for="SessionName"></span>
                    </div>
                </div>
                <div class="actions">
                    <a class="btn" asp-action="RatingSession" asp-controller="Sessions">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
