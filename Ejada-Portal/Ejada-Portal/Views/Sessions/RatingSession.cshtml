@model IEnumerable<Application.DTOs.SessionDto>
@{
    ViewData["Title"] = "Rating Session";
}
<style>
    :root {
        --bg: #0b1020;
        --card: #121933;
        --muted: #7c8db5;
        --text: #e9edff;
        --border: rgba(255,255,255,.08);
        --good: #60e6c5;
        --brand: #2d7dff; 
    }

    .wrap {
        max-width: 1200px;
        margin: 32px auto;
        padding: 0 18px
    }

    .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px
    }

    .h1 {
        font-size: 1.25rem;
        margin: 0;
        color: rgba(0,0,0,.35);
    }

    .btn {
        appearance: none;
        border: 2px solid blue;
        background: linear-gradient(180deg,rgba(255,255,255,.06),transparent);
        color: blue;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 700;
        text-decoration: none;
    }

    .btn-primary {
        border-color: rgba(106,167,255,.35);
        background: linear-gradient(135deg,rgba(106,167,255,.28),rgba(96,230,197,.28));
        border: 2px solid blue;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 18px
    }

    .card {
        background: linear-gradient(180deg,rgba(255,255,255,.02),transparent),var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 12px 30px rgba(0,0,0,.35);
        overflow: hidden
    }

    .card-hd {
        padding: 18px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px
    }

    .ttl {
        margin: 0;
        color: var(--text);
        font-weight: 800;
        line-height: 1.35
    }

    .sub {
        color: var(--muted);
        font-size: .92rem;
        margin-top: 2px
    }

    .card-bd {
        padding: 20px 22px
    }

    .row {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 14px;
        align-items: center;
        margin-bottom: 10px
    }


    .lbl {
        color: #c9d7ff;
        font-weight: 700
    }

    .cmt {
        width: 100%;
        min-height: 70px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.04);
        color: var(--text);
        padding: 10px 12px;
        outline: none
    }

    .actions {
        padding: 16px 22px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end
    }

    .save {
        min-width: 160px
    }

    .meta {
        padding: 12px 22px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: .9rem
    }

    .badge {
        font-size: .8rem;
        padding: 5px 9px;
        border-radius: 999px;
        border: 1px dashed rgba(255,255,255,.18);
        background: linear-gradient(135deg,rgba(106,167,255,.22),rgba(96,230,197,.22))
    }

    /* Rating Stars */
    .rate {
        display: inline-flex;
        gap: 6px;
        direction: ltr
    }

        .rate input {
            position: absolute;
            opacity: 0;
            pointer-events: none
        }

    .star {
        width: 26px;
        height: 26px;
        display: inline-grid;
        place-items: center;
        cursor: pointer;
        border-radius: 6px;
        transition: .15s;
        filter: grayscale(.15) brightness(.95)
    }

        .star svg {
            width: 22px;
            height: 22px;
            fill: #cbd5e1
        }

        .star:hover {
            transform: translateY(-1px)
        }

    .rate[data-value="1"] .star:nth-child(-n+1) svg,
    .rate[data-value="2"] .star:nth-child(-n+2) svg,
    .rate[data-value="3"] .star:nth-child(-n+3) svg,
    .rate[data-value="4"] .star:nth-child(-n+4) svg,
    .rate[data-value="5"] .star:nth-child(-n+5) svg {
        fill: var(--brand);
    }

    .rate:focus-within .star {
        outline: 2px solid rgba(106,167,255,.25)
    }

    .help {
        color: var(--muted);
        font-size: .85rem;
        margin-left: 8px
    }
</style>

<div class="wrap">
    <div class="top">
        <h2 class="h1">Rating Session</h2>
    </div>

    <div class="grid">
        @foreach (var s in Model)
        {
            <form asp-action="Rate" asp-controller="Sessions" method="post" class="card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SessionId" value="@s.Id" />
                <div class="card-hd">
                    <div>
                        <div class="sub">Presenter Name</div>
                        <h3 class="ttl">@s.OwnerName</h3>
                        <div class="sub" style="margin-top:10px">Session Name</div>
                        <h4 class="ttl" style="font-weight:700">@s.Name</h4>
                    </div>
                </div>

                <div class="card-bd">
                    <div class="row">
                        <div class="lbl">Rate The Presenter</div>
                        <div>
                            <div class="rate" data-name="PresenterRate" tabindex="0" aria-label="Rate the presenter from 1 to 5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <label class="star">
                                        <input type="radio" name="PresenterRate" value="@i" />
                                        @Html.Raw(@"<svg viewBox='0 0 24 24'><path d='M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z'/></svg>")
                                    </label>
                                }
                            </div>
                            <span class="help">Choose from 1 to 5</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="lbl">Rate The Session</div>
                        <div>
                            <div class="rate" data-name="SessionRate" tabindex="0" aria-label="Rate the session from 1 to 5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <label class="star">
                                        <input type="radio" name="SessionRate" value="@i" />
                                        @Html.Raw(@"<svg viewBox='0 0 24 24'><path d='M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z'/></svg>")
                                    </label>
                                }
                            </div>
                            <span class="help">Choose from 1 to 5</span>
                        </div>
                    </div>

                    <div class="row">
                        <label class="lbl" for="c-@s.Id">Your Comment</label>
                        <textarea id="c-@s.Id" name="Comment" class="cmt" placeholder="Write your opinion..."></textarea>
                    </div>
                </div>

                <div class="actions">
                    <button style="border:2px solid blue;"  type="submit" class="btn btn-outline-primary save">Save</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.rate').forEach(r => {
          const name = r.getAttribute('data-name');
          const update = v => r.setAttribute('data-value', v);
          r.addEventListener('click', e => {
            const inp = e.target.closest('label')?.querySelector('input');
            if(!inp) return;
            update(inp.value);
          });
          const checked = r.querySelector('input:checked');
          if(checked) update(checked.value);
        });
    </script>
}
