

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h3>Roles Table</h3>
            <table id="rolesTable" class="display table table-striped">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Roles dynamically added here -->
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <h3>Add New Role</h3>
            <form id="addRoleForm">
                <div class="mb-3">
                    <label for="roleName" class="form-label">Role Name</label>
                    <input type="text" class="form-control" id="roleName" placeholder="Enter role name" required>
                </div>
                <button type="submit" class="btn btn-success">Add Role</button>
            </form>
        </div>
    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function() {
        var table = $('#rolesTable').DataTable({
            ajax: {
                url: '/Roles/GetRoles',
                dataSrc: 'data'
            },
            columns: [
                { data: 'name' },
                {
                    data: 'id',
                    render: function(data) {
                        return '<button class="btn btn-danger btn-sm deleteRoleBtn" data-id="' + data + '">Delete</button>';
                    }
                }
            ]
        });

        // Handle Add Role
        $('#addRoleForm').submit(function(e) {
            e.preventDefault();
            var roleName = $('#roleName').val().trim();
            if(roleName === '') return;

            $.ajax({
                url: '/Roles/AddRole',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Name: roleName }),
                success: function() {
                    table.ajax.reload();
                    $('#roleName').val('');
                },
                error: function() {
                    alert('Role already exists or invalid name.');
                }
            });
        });

        // Handle Delete Role
        $('#rolesTable tbody').on('click', '.deleteRoleBtn', function() {
            var roleId = $(this).data('id');
            if(confirm('Are you sure you want to delete this role?')) {
                $.ajax({
                    url: '/Roles/DeleteRole',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: roleId }),
                    success: function() {
                        table.ajax.reload();
                    },
                    error: function() {
                        alert('Error deleting role.');
                    }
                });
            }
        });
    });
</script>
