<div class="container mt-5">
    <div class="row g-5">
        <!-- Roles Table -->
        <div class="col-md-6">
            <h4 class="mb-4 fw-bold text-dark">Roles Table</h4>
            <table id="rolesTable" class="table align-middle w-100" style="border-collapse: separate; border-spacing: 0 10px;">
                <thead style="background:#111; color:#fff; border-radius: 12px;">
                    <tr>
                        <th style="text-align:left; padding:12px 15px;">Role Name</th>
                        <th style="text-align:right; padding:12px 15px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Roles dynamically added here -->
                </tbody>
            </table>
        </div>

        <!-- Add Role Form -->
        <div class="col-md-6">
            <h4 class="mb-4 fw-bold text-dark">Add New Role</h4>
            <form id="addRoleForm" class="p-4 border rounded" style="background: #fff;">
                <div class="mb-3">
                    <label for="roleName" class="form-label fw-semibold">Role Name</label>
                    <input type="text" class="form-control" id="roleName" placeholder="Enter role name" required>
                </div>
                <button type="submit" class="btn btn-dark w-100">Add Role</button>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#rolesTable').DataTable({
            ajax: {
                url: '/Roles/GetRoles',
                dataSrc: 'data'
            },
            columns: [
                { data: 'name', className: 'text-start', orderable: true },
                {
                    data: 'id',
                    className: 'text-end',
                    orderable: false,
                    render: function (data) {
                        return `<button class="btn btn-sm btn-outline-dark deleteRoleBtn" data-id="${data}">Delete</button>`;
                    }
                }
            ],
            language: {
                emptyTable: "No roles available",
                search: "",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ records"
            },
            dom: '<"top d-flex justify-content-between align-items-center mb-3"l f>t<"bottom d-flex justify-content-between align-items-center mt-3"i p>'
        });

        // Add Role
        $('#addRoleForm').submit(function (e) {
            e.preventDefault();
            var roleName = $('#roleName').val().trim();
            if (!roleName) return;

            $.ajax({
                url: '/Roles/AddRole',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Name: roleName }),
                success: function () {
                    table.ajax.reload();
                    $('#roleName').val('');
                },
                error: function () {
                    alert('Role already exists or invalid name.');
                }
            });
        });

        // Delete Role
        $('#rolesTable tbody').on('click', '.deleteRoleBtn', function () {
            var roleId = $(this).data('id');
            if (confirm('Are you sure you want to delete this role?')) {
                $.ajax({
                    url: '/Roles/DeleteRole',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: roleId }),
                    success: function () {
                        table.ajax.reload();
                    },
                    error: function () {
                        alert('Error deleting role.');
                    }
                });
            }
        });
    });
</script>

<style>
    body {
        font-family: "Segoe UI", sans-serif;
        color: #222;
        background: #f8f9fa;
    }

    #rolesTable {
        border: none;
        border-radius: 12px;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        #rolesTable thead th {
            font-weight: 600;
            border: none;
            border-radius: 12px;
            padding: 12px 15px;
        }

        #rolesTable tbody tr {
            background: #fff;
            border-radius: 10px;
            transition: 0.3s;
            display: table-row;
        }

            #rolesTable tbody tr:hover {
                background-color: #f1f3f5;
            }

        #rolesTable tbody td {
            padding: 12px 15px;
            vertical-align: middle;
        }

    .btn-outline-dark {
        border: 1px solid #111;
        color: #111;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 0.85rem;
        transition: 0.3s;
    }

        .btn-outline-dark:hover {
            background-color: #111;
            color: #fff;
        }

    #addRoleForm .form-control {
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 10px 12px;
        transition: 0.3s;
    }

        #addRoleForm .form-control:focus {
            border-color: #111;
            box-shadow: none;
            outline: none;
        }

    #addRoleForm button {
        border-radius: 6px;
        padding: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

        #addRoleForm button:hover {
            background-color: #333;
            color: #fff;
        }

    .dataTables_wrapper .top,
    .dataTables_wrapper .bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        margin: 0;
    }
</style>
